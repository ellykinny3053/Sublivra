# ==========================================
# Sublivra Production Environment Variables
# ==========================================

# Security Settings
SECRET_KEY=django-insecure-change-this-to-a-random-50-character-secret-in-production
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.koyeb.app,https://*.railway.app

# Database: Supabase / Neon PostgreSQL ($0 / Free Tier)
# Get from: https://supabase.com ➔ Project Settings ➔ Database ➔ URI
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Audio Cloud Storage: Cloudflare R2 ($0 / 10GB Free + No Bandwidth Fees)
# Get from: https://dash.cloudflare.com ➔ R2 ➔ Manage R2 API Tokens
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
AWS_STORAGE_BUCKET_NAME=sublivra-audio
AWS_S3_ENDPOINT_URL=https://[YOUR_CLOUDFLARE_ACCOUNT_ID].r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
